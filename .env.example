# Environment configuration
PROJECT_NAME="OMS API"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-this-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
# Formato: postgresql+asyncpg://usuario:password@localhost:5432/nombre_db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/oms_db"

# CORS (Frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
